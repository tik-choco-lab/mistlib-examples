# scripts/sync-mistlib.sh の設定。 .env にコピーして値を埋める (.env は git 管理外)。
#
#   cp .env.example .env
#
# 取得元リポジトリとブランチは .env にのみ記述する。このテンプレートには書かない。

# 取得元リポジトリ (例: git@github.com:ORG/REPO.git)。
# MISTLIB_DEV_PATH で既存のチェックアウトを指す場合は設定不要。
MISTLIB_DEV_REPO=

# 取得するブランチ / タグ / コミット。clone して使う場合は必須。
MISTLIB_DEV_REF=

# 既存のローカルチェックアウトを使う場合はそのパスを指定する (リポジトリルートからの相対可)。
# 指定した場合はそのチェックアウトを一切変更しない (fetch も checkout もしない)。
# 空にすると .mistlib-dev/ に clone してスクリプト側で管理する。
MISTLIB_DEV_PATH=

# 1 にするとビルドを省略し、既存の成果物をコピーするだけにする。
MISTLIB_SKIP_BUILD=0
